def extract_pdf(data: bytes) -> str:
    """PDF 바이트 → 텍스트 (pdfplumber 사용)"""
    try:
        import pdfplumber
        with pdfplumber.open(io.BytesIO(data)) as pdf:
            pages = []
            for page in pdf.pages:
                text = page.extract_text()
                if text:
                    pages.append(text)
            return "\n".join(pages)
    except ImportError:
        print("    ⚠️  pdfplumber 미설치: pip install pdfplumber")
        return ""
    except Exception as e:
        print(f"    ⚠️  PDF 추출 실패: {e}")
        return ""


def extract_docx(data: bytes) -> str:
    """DOCX 바이트 → 텍스트 (python-docx 사용)"""
    try:
        from docx import Document
        doc = Document(io.BytesIO(data))
        paragraphs = [p.text for p in doc.paragraphs if p.text.strip()]
        # 표 안의 텍스트도 추출
        for table in doc.tables:
            for row in table.rows:
                row_text = " | ".join(cell.text.strip() for cell in row.cells if cell.text.strip())
                if row_text:
                    paragraphs.append(row_text)
        return "\n".join(paragraphs)
    except ImportError:
        print("    ⚠️  python-docx 미설치: pip install python-docx")
        return ""
    except Exception as e:
        print(f"    ⚠️  DOCX 추출 실패: {e}")
        return ""


def extract_hwpx(data: bytes) -> str:
    """
    HWPX 바이트 → 텍스트
    HWPX는 ZIP 구조 안에 XML이 들어있어 별도 라이브러리 불필요
    """
    try:
        texts = []
        with zipfile.ZipFile(io.BytesIO(data)) as z:
            # 본문은 Contents/section*.xml 파일들에 있음
            section_files = sorted(
                [f for f in z.namelist() if re.match(r'Contents/[Ss]ection\d+\.xml', f)]
            )
            if not section_files:
                # 일부 HWPX는 경로가 다를 수 있음
                section_files = [f for f in z.namelist() if f.endswith('.xml') and 'section' in f.lower()]

            for fname in section_files:
                xml_bytes = z.read(fname)
                soup = BeautifulSoup(xml_bytes, "xml")

                # <hp:t> 태그가 실제 텍스트를 담고 있음
                for tag in soup.find_all("hp:t"):
                    txt = tag.get_text()
                    if txt.strip():
                        texts.append(txt)

        return "\n".join(texts)
    except Exception as e:
        print(f"    ⚠️  HWPX 추출 실패: {e}")
        return ""


def extract_hwp(data: bytes) -> str:
    """
    HWP 바이트 → 텍스트 (pyhwp CLI 사용)
    pyhwp Python API보다 CLI(hwp5txt)가 훨씬 안정적
    """
    try:
        with tempfile.NamedTemporaryFile(suffix=".hwp", delete=False) as f:
            f.write(data)
            tmp_path = f.name

        result = subprocess.run(
            ["hwp5txt", tmp_path],
            capture_output=True,
            text=True,
            timeout=30
        )
        Path(tmp_path).unlink(missing_ok=True)

        if result.returncode == 0:
            return result.stdout
        else:
            print(f"    ⚠️  HWP 추출 실패: {result.stderr[:100]}")
            return ""
    except FileNotFoundError:
        print("    ⚠️  pyhwp 미설치: pip install pyhwp")
        return ""
    except Exception as e:
        print(f"    ⚠️  HWP 추출 실패: {e}")
        return ""


def extract_attachment(data: bytes, filename: str) -> str:
    """확장자에 따라 적절한 추출 함수 호출"""
    ext = Path(filename).suffix.lower()
    if ext == ".pdf":
        return extract_pdf(data)
    elif ext == ".docx":
        return extract_docx(data)
    elif ext == ".hwpx":
        return extract_hwpx(data)
    elif ext == ".hwp":
        return extract_hwp(data)
    else:
        print(f"    ⚠️  지원하지 않는 형식: {ext}")
        return ""


# ───────────────────────────────────────────────
# 첨부파일 링크 수집 및 다운로드
# ───────────────────────────────────────────────

def get_attachments(seq: int, hist: str) -> list[dict]:
    """
    lawFullView 페이지에서 첨부파일 링크를 수집하고
    각 파일의 텍스트를 추출하여 반환
    Returns: [{"filename": str, "text": str}, ...]
    """
    attachments = []
    try:
        r = session.get(
            f"{BASE}/lmxsrv/law/lawFullView.do?SEQ={seq}&SEQ_HISTORY={hist}",
            timeout=15
        )
        soup = BeautifulSoup(r.text, "html.parser")

        # 첨부파일 링크 탐색 (href에 download 또는 파일 확장자 포함)
        for a in soup.find_all("a", href=True):
            href = a["href"]
            fname = a.get_text(strip=True)

            # 파일 확장자가 있는 링크만 처리
            if not re.search(r'\.(pdf|docx?|hwpx?)(\?|$)', href, re.I):
                # href에 없으면 링크 텍스트에서 확인
                if not re.search(r'\.(pdf|docx?|hwpx?)$', fname, re.I):
                    continue

            # 상대경로 처리
            url = href if href.startswith("http") else BASE + href

            print(f"    📎 첨부파일 다운로드: {fname}")
            try:
                resp = session.get(url, timeout=30)
                if resp.status_code != 200:
                    continue

                # Content-Disposition에서 실제 파일명 추출
                cd = resp.headers.get("Content-Disposition", "")
                cd_match = re.search(r'filename[^;=\n]*=([^;\n]+)', cd)
                if cd_match:
                    fname = cd_match.group(1).strip().strip('"\'')
                    try:
                        fname = fname.encode('latin-1').decode('utf-8')
                    except Exception:
                        pass

                text = extract_attachment(resp.content, fname)
                if text:
                    attachments.append({"filename": fname, "text": text})

            except Exception as e:
                print(f"    ⚠️  다운로드 실패 ({url}): {e}")

    except Exception as e:
        print(f"    ⚠️  첨부파일 목록 수집 실패: {e}")

    return attachments


# ───────────────────────────────────────────────
# 기존 크롤링 함수 (첨부파일 추출 추가)
# ───────────────────────────────────────────────

def crawl_one(seq: int) -> dict | None:
    """규정 1개 크롤링 (첨부파일 텍스트 포함)"""
    try:
        # 1. lawDetail.do로 최신 SEQ_HISTORY 파악
        r_detail = session.get(
            f"{BASE}/lmxsrv/law/lawDetail.do",
            params={"SEQ": seq, "PAGE_MODE": ""},
            allow_redirects=True, timeout=10
        )
        if r_detail.status_code >= 400:
            return None
        if "errorPage" in r_detail.url or len(r_detail.text) < 500:
            return None

        # SEQ_HISTORY: URL에서 먼저, 없으면 HTML select에서
        m = re.search(r'SEQ_HISTORY=(\d+)', r_detail.url)
        if m:
            hist = m.group(1)
        else:
            detail_soup = BeautifulSoup(r_detail.text, "html.parser")
            sel_el = detail_soup.find("select", {"id": "histroySeq"})
            opt = sel_el.find("option", selected=True) if sel_el else None
            if not opt:
                opt = sel_el.find("option") if sel_el else None
            m2 = re.search(r'SEQ_HISTORY=(\d+)', r_detail.text)
            hist = opt["value"] if opt else (m2.group(1) if m2 else None)

        if not hist:
            return None

        # 2. lawFullView로 제목/담당부서 파악
        r_view = session.get(
            f"{BASE}/lmxsrv/law/lawFullView.do?SEQ={seq}&SEQ_HISTORY={hist}",
            timeout=15, allow_redirects=True
        )
        if r_view.status_code >= 400 or "errorPage" in r_view.url:
            return None

        view_soup = BeautifulSoup(r_view.text, "html.parser")

        # 제목
        title = ""
        stit = view_soup.select_one(".Stit")
        if stit:
            title = stit.get_text(strip=True)
            title = re.sub(r'^\d+-\d+-\S+\s*', '', title).strip()

        # 담당부서
        dept = ""
        dtit = view_soup.select_one(".Dtit")
        if dtit:
            dept = dtit.get_text(strip=True).replace("담당부서 :", "").strip()

        # 3. lawFullContent.do로 HTML 본문 수집
        rc = session.get(
            f"{BASE}/lmxsrv/law/lawFullContent.do?SEQ={seq}&SEQ_HISTORY={hist}",
            timeout=15
        )
        if rc.status_code != 200:
            return None

        content_soup = BeautifulSoup(rc.text, "html.parser")
        body = content_soup.find("body")
        content = body.get_text("\n", strip=True) if body else ""

        # 4. 첨부파일(PDF/DOCX/HWP/HWPX) 텍스트 추출
        attachments = get_attachments(seq, hist)
        if attachments:
            # 첨부파일 텍스트를 본문에 합산
            attach_texts = "\n\n".join(
                f"[첨부: {a['filename']}]\n{a['text']}" for a in attachments
            )
            content = (content + "\n\n" + attach_texts).strip()

        if len(content) < 20:
            return None

        # title 못 찾았으면 content에서 추출
        if not title or len(title) < 2:
            code_m = re.search(r'\d+-\d+-\d+\S*\s*\n\s*(.+)', content)
            title = code_m.group(1).strip() if code_m else ""
        if not title or len(title) < 2:
            return None

        attach_count = len(attachments)
        print(f"  ✅ SEQ={seq:4d} | {title[:45]}" + (f" | 첨부 {attach_count}건" if attach_count else ""))

        return {
            "seq":         seq,
            "seq_history": hist,
            "title":       title,
            "department":  dept,
            "category":    "",
            "content":     content,
            "attachments": [{"filename": a["filename"]} for a in attachments],
            "url":         f"{BASE}/lmxsrv/law/lawFullView.do?SEQ={seq}&SEQ_HISTORY={hist}"
        }

    except Exception as e:
        print(f"  ❌ SEQ={seq}: {e}")
        return None


